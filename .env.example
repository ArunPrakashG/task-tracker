# Local development values (copy to .env, which is gitignored).
DATABASE_URL=postgresql+asyncpg://postgres:pass@localhost:5432/taskdb
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Docker Compose overrides (optional; defaults shown).
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=taskdb
